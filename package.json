{
  "name": "hospital-management-system",
  "version": "1.0.0",
  "description": "Enterprise-Grade Hospital Management System (HMS) built with MERN Stack",
  "private": true,
  "scripts": {
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "seed": "cd server && npm run seed",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "test": "npm --prefix server test",
    "build": "node build.cjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "axios": "^1.6.8",
    "clsx": "^2.1.1",
    "concurrently": "^8.2.2",
    "lucide-react": "^0.372.0",
    "postcss": "^8.4.38",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.23.0",
    "tailwind-merge": "^2.3.0",
    "tailwindcss": "^3.4.3",
    "vite": "^5.2.10"
  },
  "keywords": [
    "mern",
    "hospital-management",
    "react",
    "node",
    "express",
    "mongodb",
    "rbac"
  ],
  "author": "Full-Stack Software Architect",
  "license": "MIT"
}
